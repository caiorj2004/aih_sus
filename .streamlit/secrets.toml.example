# Copie para .streamlit/secrets.toml (ignorado pelo Git) ou cole no Streamlit Cloud:
# app > Settings > Secrets. O dashboard funciona sem nenhum segredo; estes são só para o Assistente IA.

GROQ_API_KEY = "gsk_..."              # gratuita em https://console.groq.com/keys (não expira)
# LLM_MODEL = "openai/gpt-oss-120b"   # opcional; qualquer modelo do Groq com tool calling
# LIMITE_PERGUNTAS_SESSAO = 15        # opcional; protege a cota gratuita

# Opcional: gravar os logs do assistente na tabela agente_logs do PostgreSQL
# [connections.postgresql]
# dialect = "postgresql"
# host = "..."
# port = 5432
# database = "..."
# username = "..."
# password = "..."

# Opcional: usar o AWS Bedrock no lugar do Groq (usuário IAM com chave permanente, só permissão do Bedrock)
# LLM_PROVIDER = "bedrock"
# LLM_MODEL = "us.amazon.nova-lite-v1:0"
# AWS_ACCESS_KEY_ID = "..."
# AWS_SECRET_ACCESS_KEY = "..."
# AWS_DEFAULT_REGION = "us-east-1"
